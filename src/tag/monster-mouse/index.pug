extends ../../_layout.pug

block vars
  - var title = "monster mouse – Leo Auri"
  - var current = "monster-mouse"

block content
  article
    header
      h1
        a(href='/2021/monster-mouse-icy-cold/')
          span Monster Mouse:
          |  Icy Cold
      time(pubdate) November 9, 2021
    p
      a(href='/tag/monster-mouse/') Monster Mouse
      |  video for “Icy Cold”, a song from the EP 
      a(href='/2018/monster-mouse-ep-your-friend-204/') Your Friend #204
      | .
    .embed-container
      iframe(src='https://www.youtube-nocookie.com/embed/9eiWLxR1VBk?rel=0' frameborder='0' allowfullscreen).


